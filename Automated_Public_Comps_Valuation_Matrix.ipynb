      "source": [
        "## 13. Screener.in settings"
      ],
      "id": "HHa_nd_taLqn"
    },
    {
      "cell_type": "code",
      "execution_count": 142,
      "metadata": {
        "id": "-abUnWLfaLqn"
      },
      "outputs": [],
      "source": [
        "SCREENER_HEADERS = {\n",
        "    \"User-Agent\":\n",
        "        \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) \"\n",
        "        \"AppleWebKit/537.36 (KHTML, like Gecko) \"\n",
        "        \"Chrome/120.0 Safari/537.36\",\n",
        "    \"Accept\": \"text/html,application/xhtml+xml\",\n",
        "    \"Referer\": \"https://www.screener.in/\"\n",
        "}"
      ],
      "id": "-abUnWLfaLqn"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "TwT91AQpaLqo"
      },
      "source": [
        "## 14. Download Screener financial tables"
      ],
      "id": "TwT91AQpaLqo"
    },
    {
      "cell_type": "code",
      "execution_count": 143,
      "metadata": {
        "id": "r9pub02saLqo"
      },
      "outputs": [],
      "source": [
        "def get_screener_tables(symbol):\n",
        "    clean_symbol = symbol.replace(\".NS\", \"\").upper()\n",
        "\n",
        "    urls = [\n",
        "        f\"https://www.screener.in/company/{clean_symbol}/consolidated/\",\n",
        "        f\"https://www.screener.in/company/{clean_symbol}/\"\n",
        "    ]\n",
        "\n",
        "    for url in urls:\n",
        "        try:\n",
        "            response = requests.get(\n",
        "                url,\n",
        "                headers=SCREENER_HEADERS,\n",
        "                timeout=20\n",
        "            )\n",
        "\n",
        "            if response.status_code == 200:\n",
        "                tables = pd.read_html(response.text)\n",
        "\n",
        "                if len(tables) > 0:\n",
        "                    return tables\n",
        "\n",
        "        except Exception:\n",
        "            continue\n",
        "\n",
        "    print(f\"Could not retrieve Screener data for {clean_symbol}\")\n",
        "    return []"
      ],
      "id": "r9pub02saLqo"
    },
