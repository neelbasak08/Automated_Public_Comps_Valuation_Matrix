        "        tables,\n",
        "        [\"Sales\", \"Expenses\"]\n",
        "    )\n",
        "\n",
        "\n",
        "def get_balance_sheet_table(symbol):\n",
        "    tables = get_screener_tables(symbol)\n",
        "\n",
        "    return find_table_by_row(\n",
        "        tables,\n",
        "        [\"Equity\", \"Assets\"]\n",
        "    )"
